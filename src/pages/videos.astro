  heroType="image"
  heroText="Performance Videos"
  heroDeskWebp="url('https://res.cloudinary.com/driyengar/image/upload/v1629270148/banner-videos-desk_pcjetn.webp')"
  heroTabWebp="url('https://res.cloudinary.com/driyengar/image/upload/v1629270148/banner-videos-ipad_emwccj.webp')"
