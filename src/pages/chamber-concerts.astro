        Smt. Preethi Bharadwaj - 12th January 2020
      </h2>
      <EmblaCarousel images={preethiBharadwajImages} type="standard" />
    </div>
    <div class="container multi-row-section space-above">
      <p class="full-width">
        <a href="/icfa"
           class="fancy-link reverse vertical-fixed">
          <b>Back to ICFA</b>
        </a>
      </p>
    </div>
  </div>
</PageNoHeroLayout>
