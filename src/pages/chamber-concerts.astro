               loading="lazy" />
        </picture>
      </div>
    </div>

    <div class="multi-row-section container">
      <h2 class="full-width-headline center">
        Dr. Himanshu Srivastava : Trikona - Interactive Workshop, Shikhandi - Bharatanatyam Performance
