---
export interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="video-container">
  <iframe
    class="responsive-iframe"
    src={`https://www.youtube.com/embed/${id}`}
    frameborder="0"
    allowfullscreen
    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
  ></iframe>
</div>
